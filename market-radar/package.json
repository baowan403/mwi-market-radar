{
  "name": "mwi-market-radar",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --config vite.userscript.config.ts",
    "build:catalog": "node scripts/build-catalog.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "preview": "vite preview",
    "cloud:update": "tsx scripts/update-cloud-history.ts",
    "cloud:validate": "tsx scripts/update-cloud-history.ts --validate-only"
  },
  "dependencies": {
    "chart.js": "^4.4.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.15.30",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-monkey": "^5.0.8",
    "vitest": "^3.2.4"
  }
}
